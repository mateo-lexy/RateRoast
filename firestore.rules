rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 2 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidContact(c) {
      return c is map
        && c.keys().hasAll(['label', 'value'])
        && c.keys().hasOnly(['label', 'value'])
        && c.label is string && c.label.size() >= 1 && c.label.size() <= 40
        && c.value is string && c.value.size() >= 1 && c.value.size() <= 120;
    }

    function isValidProfile(data, profileId) {
      return data.keys().hasAll([
          'id', 'name', 'role', 'rate', 'cur', 'score', 'originalScore',
          'isDemoPublish', 'line', 'rewrittenPitch', 'looking', 'skills',
          'contacts', 'isSeed', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'role', 'rate', 'cur', 'score', 'originalScore',
          'isDemoPublish', 'line', 'rewrittenPitch', 'looking', 'skills',
          'contacts', 'isSeed', 'createdAt'
        ])
        && data.id == profileId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.role in ['ai', 'design', 'copy', 'dev']
        && data.rate is number && data.rate > 0 && data.rate <= 1000000000
        && data.cur in ['usd', 'idr']
        && data.score is number && data.score >= 0 && data.score <= 100
        && data.originalScore is number && data.originalScore >= 0 && data.originalScore <= 100
        && data.isDemoPublish is bool
        && data.line is string && data.line.size() >= 1 && data.line.size() <= 360
        && data.rewrittenPitch is string && data.rewrittenPitch.size() >= 1 && data.rewrittenPitch.size() <= 2000
        && data.looking in ['Technical Co-Builder', 'UI/UX Partner', 'Growth & Sales']
        && data.skills is list && data.skills.size() <= 3
        && (data.skills.size() == 0 || (data.skills[0] is string && data.skills[0].size() >= 1 && data.skills[0].size() <= 40))
        && (data.skills.size() < 2 || (data.skills[1] is string && data.skills[1].size() >= 1 && data.skills[1].size() <= 40))
        && (data.skills.size() < 3 || (data.skills[2] is string && data.skills[2].size() >= 1 && data.skills[2].size() <= 40))
        && data.contacts is list && data.contacts.size() >= 1 && data.contacts.size() <= 4
        && isValidContact(data.contacts[0])
        && (data.contacts.size() < 2 || isValidContact(data.contacts[1]))
        && data.isSeed is bool
        && data.createdAt == request.time;
    }

    function isValidCollabRequest(data, requestId) {
      return data.keys().hasAll([
          'id', 'targetProfileId', 'targetName', 'senderHandle', 'message', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'targetProfileId', 'targetName', 'senderHandle', 'message', 'createdAt'
        ])
        && data.id == requestId
        && isValidId(data.targetProfileId)
        && data.targetName is string && data.targetName.size() >= 1 && data.targetName.size() <= 80
        && data.senderHandle is string && data.senderHandle.size() >= 1 && data.senderHandle.size() <= 100
        && data.message is string && data.message.size() >= 10 && data.message.size() <= 1200
        && data.createdAt == request.time;
    }

    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    match /directory_profiles/{profileId} {
      allow list: if true;
      allow get: if isValidId(profileId);
      allow create: if isValidId(profileId) && isValidProfile(incoming(), profileId);
      allow update: if false;
      allow delete: if isValidId(profileId) && existing().isSeed == false;
    }

    match /collab_requests/{requestId} {
      allow read, update, delete: if false;
      allow create: if isValidId(requestId)
        && isValidCollabRequest(incoming(), requestId)
        && exists(/databases/$(database)/documents/directory_profiles/$(incoming().targetProfileId));
    }
  }
}
